{
  "name": "srectl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous code review and reliability agent",
  "author": "Rajveer Sharma",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ingest": "tsx watch apps/ingest/src/server.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/dashboard",
    "db:ping": "tsx scripts/db-ping.ts",
    "gh:whoami": "tsx scripts/gh-whoami.ts",
    "agent:hello": "tsx scripts/agent-hello.ts",
    "index": "tsx scripts/index-repo.ts",
    "retrieve": "tsx scripts/retrieve.ts",
    "review": "tsx scripts/review.ts",
    "sandbox:smoke": "tsx scripts/sandbox-smoke.ts",
    "sandbox:isolation": "tsx scripts/sandbox-isolation.ts",
    "testgen": "tsx scripts/testgen.ts",
    "mutation:negative": "tsx scripts/mutation-negative.ts",
    "k8s:smoke": "tsx scripts/k8s-smoke.ts",
    "build:runner": "tsx scripts/build-runner.ts",
    "test:isolation": "tsx scripts/k8s-isolation.ts",
    "chaos:up": "tsx scripts/chaos.ts up",
    "chaos:down": "tsx scripts/chaos.ts down",
    "eval:chaos": "tsx scripts/eval-chaos.ts",
    "db:migrate": "tsx scripts/events.ts migrate",
    "events:backfill": "tsx scripts/events.ts backfill",
    "events:stats": "tsx scripts/events.ts stats",
    "dev:dashboard": "pnpm --filter @srectl/dashboard dev",
    "models": "tsx scripts/models.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "smee-client": "^5.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.20.0",
    "@kubernetes/client-node": "^2.0.0",
    "@octokit/rest": "^22.0.1",
    "@srectl/agents": "workspace:*",
    "@srectl/core": "workspace:*",
    "@srectl/github": "workspace:*",
    "@srectl/retrieval": "workspace:*",
    "@srectl/sandbox": "workspace:*",
    "dotenv": "^17.2.1",
    "pg": "^8.23.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.5.4",
    "@srectl/monitor": "workspace:*"
  }
}
